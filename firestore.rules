rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        ((request.auth.token.email == 'andrewandrre88@gmail.com' || request.auth.token.email == 'packagingsg02@gmail.com') && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'category', 'shortDescription', 'description', 'image', 'createdBy']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        data.category is string && data.category.size() <= 100 &&
        data.shortDescription is string && data.shortDescription.size() <= 500 &&
        data.description is string && data.description.size() <= 5000 &&
        data.image is string && data.image.size() <= 200000 &&
        data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128;
    }

    function isValidBlogPost(data) {
      return data.keys().hasAll(['title', 'category', 'excerpt', 'content', 'author', 'image', 'createdBy']) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 250 &&
        data.category is string && data.category.size() <= 100 &&
        data.excerpt is string && data.excerpt.size() <= 800 &&
        data.content is string && data.content.size() <= 20000 &&
        data.author is string && data.author.size() <= 100 &&
        data.image is string && data.image.size() <= 200000 &&
        data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128;
    }

    // Products collection: public view, admin write
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Blog Posts collection: public view, admin write
    match /blog_posts/{postId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(postId) && isValidBlogPost(incoming());
      allow update: if isAdmin() && isValidId(postId) && isValidBlogPost(incoming());
      allow delete: if isAdmin() && isValidId(postId);
    }

    // Admins registry
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
